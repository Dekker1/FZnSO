# Doxygen configuration for the C++ binding headers.
#
# XML only: the site renders its own pages from this (see
# `docs/scripts/api/cpp.mjs`), so Doxygen's HTML output is not wanted.
#
# `c/fznso_types.h` is deliberately absent. It is generated by cbindgen from
# `rust/fznso-types`, so the ABI reference is generated from that crate instead
# and documents both spellings at once — the C struct and the Rust type are the
# same declaration.
#
# Run from the repository root: `doxygen docs/Doxyfile`.

PROJECT_NAME           = "FZnSO"
PROJECT_BRIEF          = "C++ bindings"
OUTPUT_DIRECTORY       = target/doxygen
CREATE_SUBDIRS         = NO

INPUT                  = cpp/fznso.hpp \
                         cpp/fznso_export.hpp
FILE_PATTERNS          = *.hpp
RECURSIVE              = NO

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = NO

# `detail` is the implementation behind the bindings, not part of their surface.
EXCLUDE_SYMBOLS        = fznso::detail fznso::detail::*
HIDE_UNDOC_MEMBERS     = NO
INLINE_INHERITED_MEMB  = NO

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
